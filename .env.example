# Optional local overrides. On Railway, use the Variables tab instead.
# See RAILWAY.md

# --- Fixed size (not % of account) ---
POSITION_SIZE_USD=50
MAX_OPEN_TRADES=1

# --- Phase 2: add later on Railway Variables ---
MEXC_API_KEY=
MEXC_API_SECRET=
AUTO_TRADE=false

# --- Optional tuning ---
# 600 = 10 min full scan (good default). 900 = 15 min.
SCAN_INTERVAL_SEC=600
# While a live trade is open: position check only (not full scan). 120 = 2 min.
IN_TRADE_POLL_SEC=120
MIN_CONFIDENCE=68
LOG_LEVEL=INFO
DRY_RUN=false

# Telegram is hardcoded in config.py; override only if needed:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
